# Шаблон переменных окружения. Скопировать в .env и заполнить.
# .env в git не попадает НИКОГДА. На проде — в переменных окружения Vercel.

# --- Постоянное хранение заказов в Supabase ---
# URL можно читать на клиенте, но приём заявок использует его только на сервере.
NEXT_PUBLIC_SUPABASE_URL=
# Понадобится, когда появится браузерная админка. Для приёма web-заявок не нужен.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретный ключ sb_secret_* только на сервере. В NEXT_PUBLIC_* не выносить ни при каких условиях.
SUPABASE_SECRET_KEY=
# Устаревший JWT service_role, только для уже существующих проектов Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# --- Уведомление мастеру (следующий этап; не является хранилищем заказов) ---
TODOIST_TOKEN=
TODOIST_PROJECT_ID=
TODOIST_SECTION_ID=

# --- Оплата (фаза 2, F2) ---
# Провайдер сменный. Конкретные ключи появятся после выбора банка и крипто-шлюза.
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=

# --- Оповещения (фаза 2, F3) ---
TELEGRAM_BOT_TOKEN=

# --- Прочее ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
