# Шаблон переменных окружения. Скопировать в .env и заполнить.
# .env в git не попадает НИКОГДА. На проде — в переменных окружения Vercel.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Сервисный ключ только на сервере. В NEXT_PUBLIC_* не выносить ни при каких условиях.
SUPABASE_SERVICE_ROLE_KEY=

# --- Приём заказов до админки (трек M4, временно) ---
TODOIST_TOKEN=
TODOIST_PROJECT_ID=
TODOIST_SECTION_ID=

# --- Оплата (фаза 2, F2) ---
# Провайдер сменный. Конкретные ключи появятся после выбора банка и крипто-шлюза.
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=

# --- Оповещения (фаза 2, F3) ---
TELEGRAM_BOT_TOKEN=

# --- Прочее ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
