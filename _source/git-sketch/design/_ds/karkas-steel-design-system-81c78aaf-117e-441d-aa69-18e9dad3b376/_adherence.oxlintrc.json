{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/**",
              "components/buttons/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|price|disabled|fullWidth|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children, price, disabled, fullWidth, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|image|imageHeight|hoverable|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, image, imageHeight, hoverable, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorSwatches'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|ringOffsetColor|style|key|ref|className|style|children)$/]",
        "message": "<ColorSwatches> doesn't accept that prop. Declared props: options, value, onChange, ringOffsetColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|onClick|active|size|iconSize|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, onClick, active, size, iconSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|suffix|mono|error|type|id|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, suffix, mono, error, type, id, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrdersTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:orders|onRowClick|style|key|ref|className|style|children)$/]",
        "message": "<OrdersTable> doesn't accept that prop. Declared props: orders, onRowClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderTimeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|style|key|ref|className|style|children)$/]",
        "message": "<OrderTimeline> doesn't accept that prop. Declared props: steps, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Price'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|size|muted|style|key|ref|className|style|children)$/]",
        "message": "<Price> doesn't accept that prop. Declared props: value, currency, size, muted, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|mono|label|style|key|ref|className|style|children)$/]",
        "message": "<SegmentControl> doesn't accept that prop. Declared props: options, value, onChange, mono, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|min|max|step|value|onChange|unit|style|key|ref|className|style|children)$/]",
        "message": "<SizeSlider> doesn't accept that prop. Declared props: label, min, max, step, value, onChange, unit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: status, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:awaiting-payment|received|production|ready|delivery|pickup|done|cancelled)$/]",
        "message": "<StatusChip> status must be one of 'awaiting-payment' | 'received' | 'production' | 'ready' | 'delivery' | 'pickup' | 'done' | 'cancelled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, action, onAction, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
